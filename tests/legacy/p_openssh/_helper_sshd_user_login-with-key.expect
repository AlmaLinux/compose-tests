#!/usr/bin/expect -f
# Author: Athmane Madjoudj <athmanem@gmail.com>

# An emulated guest (the CI on forks) answers more slowly
if {[info exists env(emulated_guest)] && $env(emulated_guest) eq "true"} {
    set timeout 30
} else {
    set timeout 2
}
spawn ssh -o StrictHostKeyChecking=no sshtest@localhost /bin/cat ssh_test_file
send -- "\r"
expect eof
